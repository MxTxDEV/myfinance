// Finance OS — modelo relacional (uso pessoal, um único proprietário).
// Dinheiro: sempre Decimal(14,2) em BRL. Nunca Float.
// Regras de negócio: ver docs/DECISIONS.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  DIGITAL
  CASH
  SAVINGS
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

// INVOICE_PAYMENT e DEBT_PAYMENT são saídas de caixa que liquidam obrigações já
// reconhecidas; NÃO entram em "despesas" nos relatórios (evita contar duas vezes).
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  INVOICE_PAYMENT
  DEBT_PAYMENT
  INVESTMENT_OUT // aporte: sai da conta para um investimento (não é despesa)
  INVESTMENT_IN // resgate: volta do investimento para a conta (não é receita)
}

// PLANNED = previsto (não afeta saldo real). SETTLED = recebido/pago (afeta saldo).
enum TransactionStatus {
  PLANNED
  SETTLED
}

enum Recurrence {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum AssetType {
  INVESTMENT
  PROPERTY
  VEHICLE
  EQUIPMENT
  OTHER
}

enum NotificationType {
  DUE_SOON
  OVERDUE
  BUDGET
  GOAL_STALLED
  MONTHLY_SUMMARY
  INVOICE_CLOSING
  INVOICE_DUE
  DAILY_MESSAGE
  DEBT_DUE
  CELEBRATION // parabéns por uma conquista (meta, dívida quitada, mês no azul…)
}

enum InvestmentType {
  FIXED_INCOME
  TREASURY
  STOCKS
  REAL_ESTATE_FUND
  FUNDS
  CRYPTO
  PENSION
  OTHER
}

enum InvestmentEntryKind {
  CONTRIBUTION
  WITHDRAWAL
  VALUE_UPDATE
}

model Profile {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  // incrementa ao trocar a senha: invalida sessões antigas
  sessionVersion     Int       @default(0)
  theme              String    @default("system")
  hideValues         Boolean   @default(false)
  notifyPrefs        Json      @default("{}")
  planPrefs          Json      @default("{}") // plano financeiro: renda informada, gasto variável escolhido, estratégia de quitação
  currency           String    @default("BRL")
  role               Role      @default(USER)
  active             Boolean   @default(true) // desativada: não consegue entrar
  mustChangePassword Boolean   @default(false) // senha temporária: troca obrigatória no próximo acesso
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts          Account[]
  categories        Category[]
  transfers         Transfer[]
  creditCards       CreditCard[]
  invoices          Invoice[]
  installmentPlans  InstallmentPlan[]
  recurrings        RecurringCommitment[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  goalEntries       GoalEntry[]
  debts             Debt[]
  assets            Asset[]
  notifications     Notification[]
  investments       Investment[]
  investmentEntries InvestmentEntry[]
  pushSubscriptions PushSubscription[]
  pushSlots         PushSlot[]
  apiTokens         ApiToken[]
  bankLinks         BankLink[]
  bankLinkAccounts  BankLinkAccount[]
}

enum Role {
  USER
  SUPER_ADMIN
}

// Configurações do app inteiro (ex.: cadastro aberto). Não pertencem a nenhum usuário.
model Setting {
  key   String @id
  value Json
}

// Conexão bancária via Open Finance (Pluggy). Um "item" = uma instituição autorizada pelo usuário.
model BankLink {
  id         String    @id @default(cuid())
  itemId     String
  connector  String
  status     String    @default("UPDATED")
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())

  accounts BankLinkAccount[]

  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

// Conta/cartão do banco → conta/cartão do app (ou ainda sem destino).
model BankLinkAccount {
  id              String   @id @default(cuid())
  linkId          String
  pluggyAccountId String
  name            String
  kind            String // ACCOUNT | CARD
  subtype         String?
  balance         Decimal? @db.Decimal(14, 2)
  creditLimit     Decimal? @db.Decimal(14, 2)
  closingDay      Int?
  dueDay          Int?
  accountId       String?
  cardId          String?
  createdByLink   Boolean  @default(false) // conta/cartão criado pela conexão: saldo inicial é calculado a partir do saldo do banco
  synced          Boolean  @default(false)
  createdAt       DateTime @default(now())

  link BankLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pluggyAccountId])
  @@index([userId])
}

// Chave para lançamentos automáticos (Atalhos do iPhone, Tasker…). Só o hash é guardado.
model ApiToken {
  id         String    @id @default(cuid())
  label      String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                 String      @id @default(cuid())
  name               String
  institution        String?
  type               AccountType
  initialBalance     Decimal     @default(0) @db.Decimal(14, 2)
  initialBalanceDate DateTime    @db.Date
  color              String      @default("#4338CA")
  icon               String      @default("wallet")
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  transactions Transaction[]
  cardsPaying  CreditCard[]
  goals        Goal[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id         String       @id @default(cuid())
  name       String
  type       CategoryType
  icon       String       @default("tag")
  color      String       @default("#64748B")
  favorite   Boolean      @default(false)
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  transactions Transaction[]
  budgets      Budget[]
  recurrings   RecurringCommitment[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId])
}

model Transfer {
  id            String    @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amount        Decimal   @db.Decimal(14, 2)
  date          DateTime  @db.Date
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fromAccount  Account       @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount    Account       @relation("TransferTo", fields: [toAccountId], references: [id])
  transactions Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
}

model CreditCard {
  id           String    @id @default(cuid())
  name         String
  issuer       String?
  limit        Decimal   @db.Decimal(14, 2)
  closingDay   Int
  dueDay       Int
  payAccountId String
  color        String    @default("#7C3AED")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payAccount   Account           @relation(fields: [payAccountId], references: [id])
  invoices     Invoice[]
  transactions Transaction[]
  plans        InstallmentPlan[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Uma fatura por cartão e mês de referência (mês em que a fatura FECHA). Ex.: "2026-10".
model Invoice {
  id             String   @id @default(cuid())
  cardId         String
  referenceMonth String
  closingDate    DateTime @db.Date
  dueDate        DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  card         CreditCard    @relation(fields: [cardId], references: [id])
  transactions Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, referenceMonth])
  @@index([dueDate])
  @@index([userId])
}

model InstallmentPlan {
  id           String   @id @default(cuid())
  cardId       String
  description  String
  totalAmount  Decimal  @db.Decimal(14, 2)
  count        Int
  purchaseDate DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  card         CreditCard    @relation(fields: [cardId], references: [id])
  transactions Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecurringCommitment {
  id           String       @id @default(cuid())
  description  String
  type         CategoryType
  amount       Decimal      @db.Decimal(14, 2)
  categoryId   String
  accountId    String?
  cardId       String?
  recurrence   Recurrence
  intervalDays Int?
  startDate    DateTime     @db.Date
  endDate      DateTime?    @db.Date
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id                String            @id @default(cuid())
  type              TransactionType
  status            TransactionStatus @default(SETTLED)
  amount            Decimal           @db.Decimal(14, 2) // sempre positivo; o sinal vem do tipo
  description       String
  date              DateTime          @db.Date // data da competência / do pagamento
  dueDate           DateTime?         @db.Date
  settledAt         DateTime?
  categoryId        String?
  accountId         String? // nulo em compras no cartão (não mexe no saldo bancário)
  cardId            String?
  invoiceId         String?
  payerSource       String?
  notes             String?
  attachmentUrl     String?
  transferId        String?
  planId            String?
  installmentNumber Int?
  recurringId       String?
  occurrenceDate    DateTime?         @db.Date
  debtId            String?
  investmentId      String?
  // Idempotência de lançamentos enviados pela fila offline (UUID gerado no aparelho).
  clientId          String?           @unique
  // Origem em extrato importado (OFX/CSV ou, no futuro, Open Finance): reimportar o mesmo arquivo nunca duplica.
  importKey         String?           @unique
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  category   Category?            @relation(fields: [categoryId], references: [id])
  account    Account?             @relation(fields: [accountId], references: [id])
  card       CreditCard?          @relation(fields: [cardId], references: [id])
  invoice    Invoice?             @relation(fields: [invoiceId], references: [id])
  transfer   Transfer?            @relation(fields: [transferId], references: [id])
  plan       InstallmentPlan?     @relation(fields: [planId], references: [id])
  recurring  RecurringCommitment? @relation(fields: [recurringId], references: [id])
  debt       Debt?                @relation(fields: [debtId], references: [id])
  investment Investment?          @relation(fields: [investmentId], references: [id])

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotência de recorrências: uma ocorrência por (compromisso, data).
  @@unique([recurringId, occurrenceDate])
  @@index([date])
  @@index([accountId, date])
  @@index([cardId, invoiceId])
  @@index([categoryId, date])
  @@index([status, date])
  @@index([description])
  @@index([userId])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String   @unique
  limit      Decimal  @db.Decimal(14, 2)
  alertAt    Int[]    @default([50, 80, 100])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime? @db.Date
  priority     Int       @default(2)
  description  String?
  accountId    String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account Account?    @relation(fields: [accountId], references: [id])
  entries GoalEntry[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Aporte (+) ou retirada (−). Não é receita nem despesa: é reserva dentro do patrimônio.
model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  amount    Decimal  @db.Decimal(14, 2) // positivo = aporte, negativo = retirada
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id])

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@index([userId])
}

model Debt {
  id                String    @id @default(cuid())
  name              String
  creditor          String?
  originalAmount    Decimal   @db.Decimal(14, 2)
  balance           Decimal   @db.Decimal(14, 2)
  monthlyRate       Decimal?  @db.Decimal(8, 4) // % ao mês, quando conhecida
  installmentAmount Decimal?  @db.Decimal(14, 2)
  installmentsTotal Int?
  nextDueDate       DateTime? @db.Date
  kind              String    @default("OUTRO") // CARTAO | VEICULO | FINANCIAMENTO | EMPRESTIMO | OUTRO (só para organizar)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Asset {
  id             String    @id @default(cuid())
  name           String
  type           AssetType
  value          Decimal   @db.Decimal(14, 2)
  valueUpdatedAt DateTime  @db.Date
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  // Evita repetição: uma notificação por chave (ex.: "budget:cat:2026-10:80").
  dedupeKey String
  readAt    DateTime?
  // Quando o aviso virou notificação push (nulo = ainda não enviado).
  pushedAt  DateTime?
  createdAt DateTime         @default(now())

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([readAt, createdAt])
  @@index([userId])
}

model Investment {
  id             String         @id @default(cuid())
  name           String
  type           InvestmentType
  institution    String?
  currentValue   Decimal        @db.Decimal(14, 2)
  valueUpdatedAt DateTime       @db.Date
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  entries      InvestmentEntry[]
  transactions Transaction[]

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Histórico do investimento. CONTRIBUTION/WITHDRAWAL = valor movimentado (>0);
// VALUE_UPDATE = novo valor de mercado informado pelo usuário (>=0).
model InvestmentEntry {
  id            String              @id @default(cuid())
  investmentId  String
  kind          InvestmentEntryKind
  amount        Decimal             @db.Decimal(14, 2)
  date          DateTime            @db.Date
  note          String?
  transactionId String?             @unique
  createdAt     DateTime            @default(now())

  investment Investment @relation(fields: [investmentId], references: [id])

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([investmentId, date])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PushKind {
  MORNING // mensagem da manhã (primeira do dia)
  SPEND // "pense antes de gastar"
  INVEST // incentivo a investir
  MOTIVATION // incentivo "não desista" (o que você perde se parar)
  PERSONAL // mensagem montada na hora com os SEUS números (gastos pequenos acumulados, ritmo do mês, dívidas…)
}

// Um horário sorteado do dia para uma mensagem. (day, slot) único: gerar de novo nunca duplica.
model PushSlot {
  id        String    @id @default(cuid())
  day       String // "YYYY-MM-DD" (America/Sao_Paulo)
  slot      Int
  at        DateTime // instante do envio
  kind      PushKind
  message   String
  sentAt    DateTime?
  skipped   Boolean   @default(false) // passou muito do horário (agendador parado): não envia fora de hora
  prefsKey  String // resumo das preferências que geraram este horário; mudou → sorteia de novo os não enviados
  createdAt DateTime  @default(now())

  // Dono dos dados: preenchido automaticamente pelo cliente com escopo de usuário (src/server/db.ts).
  userId String  @default("")
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, slot])
  @@index([day, sentAt])
  @@index([userId])
}

// Batimento do agendador externo (para avisar se ele parar de chamar o servidor).
model Heartbeat {
  key String   @id
  at  DateTime
}
