# Copie para .env e preencha. Nunca versione o .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finance_os"
# Mínimo 32 caracteres aleatórios (openssl rand -base64 48)
AUTH_SECRET=""
# Super administrador (criado/promovido no deploy por `npm run db:bootstrap`).
# A senha é TEMPORÁRIA: o app exige trocá-la no primeiro acesso. Depois pode remover SUPERADMIN_PASSWORD.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME=""
# "1" redefine a senha de um admin já existente (esqueci a senha)
SUPERADMIN_FORCE_RESET=""

# --- Mensagem das 06:00 (notificação push) e agendador ---
# Gere o par de chaves com:  npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@email.com"
# Segredo da rota /api/cron/daily (mín. 16 caracteres). O Vercel Cron envia como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# --- Open Finance (Pluggy) — crie a conta em https://dashboard.pluggy.ai ---
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# "1" mostra os bancos de TESTE (sandbox) no widget; deixe vazio em produção real
PLUGGY_SANDBOX=""
# URL pública https do app (para o aviso automático/webhook da Pluggy). Opcional: usa a origem da requisição.
APP_URL=""
# Segredo do webhook (opcional; senão é derivado do AUTH_SECRET)
PLUGGY_WEBHOOK_SECRET=""
