# Copie para .env e preencha. Nunca versione o .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finance_os"
# Mínimo 32 caracteres aleatórios (openssl rand -base64 48)
AUTH_SECRET=""
# TEMPORÁRIO: "true" desliga o login (app aberto a quem tiver a URL). Remova para voltar a exigir senha.
AUTH_DISABLED=""
# Usados apenas por `npm run db:seed-owner` para criar o proprietário
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""
